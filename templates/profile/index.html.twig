{% extends 'base.html.twig' %}

{% block title %}Mon Profile - EcoTrack{% endblock %}

{% block body %}
<div class="mx-auto max-w-5xl px-4 py-6 sm:px-0">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">Mon Profile</h1>
        <p class="text-gray-600 dark:text-gray-300">Gérez vos informations personnelles et votre sécurité.</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-500/20 dark:bg-emerald-500/10 dark:text-emerald-300">
            {{ message }}
        </div>
    {% endfor %}

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Compte</h2>
            <dl class="space-y-3 text-sm">
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">Email</dt>
                    <dd class="text-gray-900 dark:text-gray-100">{{ user.email }}</dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">Nom complet</dt>
                    <dd class="text-gray-900 dark:text-gray-100">
                        {% if user.firstName or user.lastName %}
                            {{ user.firstName ?? '' }} {{ user.lastName ?? '' }}
                        {% else %}
                            Non renseigné
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt class="text-gray-500 dark:text-gray-400">Membre depuis</dt>
                    <dd class="text-gray-900 dark:text-gray-100">{{ user.createdAt ? user.createdAt|date('d/m/Y') : '-' }}</dd>
                </div>
            </dl>
        </div>

        <div class="xl:col-span-2 space-y-6">
            <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Informations personnelles</h2>
                {{ form_start(profileForm) }}
                    {{ form_row(profileForm.email) }}
                    {{ form_row(profileForm.firstName) }}
                    {{ form_row(profileForm.lastName) }}
                    <div class="mt-4 flex justify-end">
                        <button type="submit" class="inline-flex items-center rounded-lg bg-emerald-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-600">
                            Enregistrer le profil
                        </button>
                    </div>
                {{ form_end(profileForm) }}
            </section>

            <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Sécurité</h2>
                {{ form_start(passwordForm) }}
                    {{ form_row(passwordForm.currentPassword) }}
                    {{ form_row(passwordForm.plainPassword.first) }}
                    {{ form_row(passwordForm.plainPassword.second) }}
                    <div class="mt-4 flex justify-end">
                        <button type="submit" class="inline-flex items-center rounded-lg bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-700 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-gray-300">
                            Changer le mot de passe
                        </button>
                    </div>
                {{ form_end(passwordForm) }}
            </section>
        </div>
    </div>
</div>
{% endblock %}
