<form method="post" action="{{ path('logement_delete', {'id': logement.id}) }}" onsubmit="return confirm('Supprimer ce logement ? Cette action est irreversible.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_logement_' ~ logement.id) }}">
    <button class="inline-flex items-center rounded-lg border border-red-300 px-3 py-1.5 text-xs font-semibold text-red-700 transition hover:bg-red-50 dark:border-red-500/30 dark:text-red-300 dark:hover:bg-red-500/10">
        Supprimer
    </button>
</form>
