{% extends 'base.html.twig' %}

{% block title %}{{ logement.nom }} - EcoTrack{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-4 py-6 sm:px-0">
    <div class="mb-6">
        <a href="{{ path('logement_index') }}" class="inline-flex items-center gap-2 text-sm font-medium text-emerald-600 transition hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Retour à mes logements
        </a>
    </div>

    <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900 sm:p-8">
        <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ logement.nom }}</h1>
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{{ logement.adresse }}</p>
            </div>
            <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300">Actif</span>
        </div>

        <dl class="grid grid-cols-1 gap-4 rounded-lg bg-gray-50 p-4 dark:bg-gray-800/50 sm:grid-cols-2">
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Nom</dt>
                <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">{{ logement.nom }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Adresse</dt>
                <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">{{ logement.adresse }}</dd>
            </div>
        </dl>

        <div class="mt-6 flex flex-wrap items-center gap-2">
            <a href="{{ path('logement_edit', {'id': logement.id}) }}" class="inline-flex items-center rounded-lg border border-emerald-300 px-3 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50 dark:border-emerald-500/30 dark:text-emerald-300 dark:hover:bg-emerald-500/10">
                Modifier
            </a>
            {{ include('logement/_delete_form.html.twig', { logement: logement }) }}
        </div>
    </article>
</div>
{% endblock %}
