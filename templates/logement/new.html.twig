{% extends 'base.html.twig' %}

{% block title %}Ajouter un logement - EcoTrack{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-4 py-4 sm:py-6 sm:px-0">
    {% for message in app.flashes('error') %}
        <div class="mb-4 sm:mb-6 rounded-lg border border-red-200 bg-red-50 px-3 sm:px-4 py-2 sm:py-3 text-xs sm:text-sm text-red-800 dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-300">
            {{ message }}
        </div>
    {% endfor %}

    <div class="mb-4 sm:mb-6">
        <a href="{{ path('logement_index') }}" class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-600 transition hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            <span class="hidden sm:inline">Retour à mes logements</span>
            <span class="sm:hidden">Retour</span>
        </a>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-4 sm:p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900 lg:p-8">
        <div class="mb-4 sm:mb-6">
            <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">Ajouter un logement</h1>
            <p class="mt-2 text-xs sm:text-sm text-gray-600 dark:text-gray-300">Renseignez les informations de votre logement pour commencer le suivi.</p>
        </div>

        {{ include('logement/_form.html.twig', { form: form, button_label: 'Enregistrer le logement' }) }}
    </div>
</div>
{% endblock %}
