{% extends 'base.html.twig' %}

{% block title %}EcoTrack - Suivi énergétique intelligent{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .home-hero {
            position: relative;
            overflow: hidden;
            isolation: isolate;
        }

        .home-blob {
            position: absolute;
            border-radius: 9999px;
            filter: blur(60px);
            opacity: 0.45;
            pointer-events: none;
            z-index: -1;
            transition: transform 200ms ease-out;
        }

        .home-blob-a {
            width: 380px;
            height: 380px;
            top: -120px;
            right: -80px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.55), rgba(16, 185, 129, 0));
        }

        .home-blob-b {
            width: 320px;
            height: 320px;
            bottom: 8%;
            left: -120px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.45), rgba(59, 130, 246, 0));
        }

        .f-card {
            position: relative;
            overflow: hidden;
            transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
            backdrop-filter: blur(6px);
        }

        .f-card::before {
            content: "";
            position: absolute;
            inset: -40%;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.16), rgba(16, 185, 129, 0));
            opacity: 0;
            transition: opacity 180ms ease;
            pointer-events: none;
        }

        .f-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 30px rgba(2, 8, 23, 0.12);
            border-color: rgba(16, 185, 129, 0.4);
        }

        .f-card:hover::before {
            opacity: 1;
        }

        [data-reveal] {
            opacity: 0;
            transform: translateY(20px) scale(0.99);
            transition: opacity 450ms ease, transform 450ms ease;
        }

        [data-reveal].is-visible {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    </style>
{% endblock %}

{% block body %}
