{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - EcoTrack{% endblock %}

{% block body %}
<div class="px-4 py-6 sm:px-0">
    <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">Tableau de bord</h1>
            <p class="text-gray-600 dark:text-gray-300">Suivez vos relevés énergétiques</p>
        </div>
        <button id="export-dashboard-pdf" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-600">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3M5 20h14a1 1 0 001-1v-3M4 16v3a1 1 0 001 1"/>
            </svg>
            Télécharger le PDF
        </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        {% for typeEnergie in typesEnergie %}
            <div class="bg-white dark:bg-gray-900 rounded-lg shadow p-6 border border-gray-100 dark:border-gray-800">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{{ typeEnergie.nom }}</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Mois {{ currentMonthLabel }}</p>
                        <p class="mt-2 text-2xl font-bold text-emerald-600 dark:text-emerald-300">
                            {{ (monthlyTotalsByType[typeEnergie.id]|default(0))|number_format(2, ',', ' ') }}
                            <span class="text-sm font-medium text-gray-500 dark:text-gray-400">{{ typeEnergie.unite ?? 'kWh' }}</span>
                        </p>
                    </div>
                    {% if typeEnergie.icone %}
                        <span class="text-3xl">{{ typeEnergie.icone }}</span>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="mb-8">
        <div class="mb-4">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Graphiques par énergie</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400">Détail quotidien des relevés pour {{ currentMonthLabel }}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            {% for typeEnergie in typesEnergie %}
                <div class="bg-white dark:bg-gray-900 rounded-lg shadow border border-gray-100 dark:border-gray-800 p-5">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">{{ typeEnergie.nom }}</h3>
                        {% if typeEnergie.icone %}
                            <span class="text-xl">{{ typeEnergie.icone }}</span>
                        {% endif %}
                    </div>
                    <div class="h-48">
                        <canvas id="dashboard-type-chart-{{ typeEnergie.id }}"></canvas>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="bg-white dark:bg-gray-900 rounded-lg shadow border border-gray-100 dark:border-gray-800">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Mes relevés</h2>
        </div>
        <div class="p-6">
            {% if consommations|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800">
                        <thead class="bg-gray-50 dark:bg-gray-800/60">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Type</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Valeur</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-800">
                            {% for consommation in consommations %}
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                                        {{ consommation.dateReleve|date('d/m/Y') }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                                        {{ consommation.typeEnergie.nom }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                                        {{ consommation.valeur }} {{ consommation.typeEnergie.unite ?? 'kWh' }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-12">
                    <p class="text-gray-500 dark:text-gray-300 mb-4">Aucun relevé enregistré pour le moment.</p>
                    <a href="{{ path('consommation_new') }}" class="inline-flex items-center px-4 py-2 bg-emerald-500 text-white rounded-md hover:bg-emerald-600">
                        Ajouter un relevé
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="mt-8 bg-white dark:bg-gray-900 rounded-lg shadow border border-gray-100 dark:border-gray-800">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between gap-3">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Alertes récentes</h2>
            <a href="{{ path('alerte_index') }}" class="text-sm font-medium text-emerald-600 hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300">Voir toutes les alertes</a>
        </div>
        <div class="p-6">
            {% if alertesRecentes|length > 0 %}
                <ul class="space-y-3">
                    {% for alerte in alertesRecentes %}
                        <li class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 dark:border-amber-500/20 dark:bg-amber-500/10">
                            <p class="text-sm font-semibold text-amber-900 dark:text-amber-200">{{ alerte.titre }}</p>
                            <p class="text-xs text-amber-800/80 dark:text-amber-300/80 mt-1">{{ alerte.logement.nom }} · {{ alerte.createdAt|date('d/m/Y H:i') }}</p>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <div class="text-center py-6">
                    <p class="text-gray-500 dark:text-gray-300 mb-4">Aucune alerte non lue.</p>
                    <a href="{{ path('alerte_new') }}" class="inline-flex items-center px-4 py-2 bg-emerald-500 text-white rounded-md hover:bg-emerald-600">
                        Créer une alerte
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script>
        (function () {
            const perTypeChartData = {{ perTypeChartData|json_encode|raw }};
            if (!perTypeChartData) return;

            const isDark = document.documentElement.classList.contains('dark');
            const gridColor = isDark ? 'rgba(255, 255, 255, 0.12)' : 'rgba(17, 24, 39, 0.10)';
            const axisColor = isDark ? '#D1D5DB' : '#6B7280';

            if (perTypeChartData) {
                Object.entries(perTypeChartData).forEach(([typeId, data]) => {
                    const canvas = document.getElementById(`dashboard-type-chart-${typeId}`);
                    if (!canvas) return;

                    const labels = Array.isArray(data.labels) ? data.labels : [];
                    const values = Array.isArray(data.values) ? data.values : [];
                    const color = data.color || '#10B981';

                    new Chart(canvas, {
                        type: 'line',
                        data: {
                            labels,
                            datasets: [{
                                data: values,
                                borderColor: color,
                                backgroundColor: `${color}2A`,
                                fill: true,
                                pointRadius: 0,
                                tension: 0.35
                            }]
                        },
                        options: {
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: { mode: 'index', intersect: false }
                            },
                            scales: {
                                x: { ticks: { color: axisColor, maxTicksLimit: 6 }, grid: { color: gridColor } },
                                y: { beginAtZero: true, ticks: { color: axisColor, maxTicksLimit: 4 }, grid: { color: gridColor } }
                            }
                        }
                    });
                });
            }

            const monthlyTotals = [
                {% for typeEnergie in typesEnergie %}
                {
                    label: '{{ (typeEnergie.nom ?? 'Type')|e('js') }}',
                    value: '{{ (monthlyTotalsByType[typeEnergie.id]|default(0))|number_format(2, ',', ' ') }} {{ (typeEnergie.unite ?? 'kWh')|e('js') }}'
                }{% if not loop.last %},{% endif %}
                {% endfor %}
            ];

            const exportBtn = document.getElementById('export-dashboard-pdf');
            if (!exportBtn || !window.jspdf || !window.jspdf.jsPDF) return;

            const addPageIfNeeded = (doc, y, neededHeight) => {
                const pageHeight = doc.internal.pageSize.getHeight();
                if (y + neededHeight > pageHeight - 10) {
                    doc.addPage();
                    return 16;
                }
                return y;
            };

            exportBtn.addEventListener('click', () => {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({ orientation: 'p', unit: 'mm', format: 'a4' });
                const pageWidth = doc.internal.pageSize.getWidth();
                const maxWidth = pageWidth - 20;
                let y = 16;

                doc.setFontSize(16);
                doc.text('EcoTrack - Export dashboard', 10, y);
                y += 7;
                doc.setFontSize(10);
                doc.setTextColor(100);
                doc.text(`Date d'export: ${new Date().toLocaleString('fr-FR')}`, 10, y);
                y += 8;

                doc.setTextColor(30);
                doc.setFontSize(12);
                doc.text('Consommations du mois par energie', 10, y);
                y += 6;
                doc.setFontSize(10);
                monthlyTotals.forEach((item) => {
                    y = addPageIfNeeded(doc, y, 6);
                    doc.text(`- ${item.label}: ${item.value}`, 10, y);
                    y += 5;
                });
                y += 3;

                const chartCanvases = Array.from(document.querySelectorAll('canvas[id^="dashboard-type-chart-"]'));
                chartCanvases.forEach((canvas) => {
                    if (!(canvas instanceof HTMLCanvasElement)) return;

                    const parentCard = canvas.closest('.bg-white');
                    const titleNode = parentCard ? parentCard.querySelector('h3') : null;
                    const chartTitle = titleNode ? titleNode.textContent.trim() : 'Graphique';
                    const imgData = canvas.toDataURL('image/png');

                    y = addPageIfNeeded(doc, y, 58);
                    doc.setFontSize(11);
                    doc.setTextColor(30);
                    doc.text(`Graphique ${chartTitle}`, 10, y);
                    y += 3;

                    const imgHeight = 50;
                    doc.addImage(imgData, 'PNG', 10, y, maxWidth, imgHeight);
                    y += imgHeight + 6;
                });

                const tableRows = document.querySelectorAll('table tbody tr');
                if (tableRows.length > 0) {
                    y = addPageIfNeeded(doc, y, 12);
                    doc.setFontSize(12);
                    doc.text('Releves', 10, y);
                    y += 6;
                    doc.setFontSize(10);

                    tableRows.forEach((row) => {
                        const cells = row.querySelectorAll('td');
                        if (cells.length < 3) return;
                        const line = `${cells[0].textContent.trim()} | ${cells[1].textContent.trim()} | ${cells[2].textContent.trim()}`;
                        y = addPageIfNeeded(doc, y, 5);
                        doc.text(line, 10, y, { maxWidth });
                        y += 5;
                    });
                }

                const dateTag = new Date().toISOString().slice(0, 10);
                doc.save(`ecotrack-dashboard-${dateTag}.pdf`);
            });
        })();
    </script>
{% endblock %}
