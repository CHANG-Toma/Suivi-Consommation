{% extends 'base.html.twig' %}

{% block title %}Détail alerte - EcoTrack{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-4 py-6 sm:px-0">
    <div class="mb-6">
        <a href="{{ path('alerte_index') }}" class="inline-flex items-center gap-2 text-sm font-medium text-emerald-600 transition hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Retour à mes alertes
        </a>
    </div>

    <article class="rounded-xl border bg-white p-6 shadow-sm dark:bg-gray-900 sm:p-8 {{ alerte.lu ? 'border-gray-200 dark:border-gray-800' : 'border-amber-300 dark:border-amber-500/40' }}">
        <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ alerte.titre }}</h1>
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{{ alerte.message ?: 'Aucun message détaillé.' }}</p>
            </div>
            <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium {{ alerte.lu ? 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200' : 'bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300' }}">
                {{ alerte.lu ? 'Lue' : 'Non lue' }}
            </span>
        </div>

        <dl class="grid grid-cols-1 gap-4 rounded-lg bg-gray-50 p-4 dark:bg-gray-800/50 sm:grid-cols-2">
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Logement</dt>
                <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">{{ alerte.logement.nom }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Type d'énergie</dt>
                <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">{{ alerte.typeEnergie ? alerte.typeEnergie.nom : 'Tous types' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Seuil</dt>
                <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">{{ alerte.seuil is not null ? alerte.seuil : 'Non défini' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Créée le</dt>
                <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">{{ alerte.createdAt|date('d/m/Y H:i') }}</dd>
            </div>
        </dl>

        <div class="mt-6 flex flex-wrap items-center gap-2">
            <a href="{{ path('alerte_edit', {'id': alerte.id}) }}" class="inline-flex items-center rounded-lg border border-emerald-300 px-3 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50 dark:border-emerald-500/30 dark:text-emerald-300 dark:hover:bg-emerald-500/10">
                Modifier
            </a>
            {{ include('alerte/_toggle_read_form.html.twig', { alerte: alerte }) }}
            {{ include('alerte/_delete_form.html.twig', { alerte: alerte }) }}
        </div>
    </article>
</div>
{% endblock %}
