{% extends 'base.html.twig' %}

{% block title %}Mes alertes - EcoTrack{% endblock %}

{% block body %}
<div class="px-4 py-4 sm:py-6 sm:px-0">
    <div class="mb-6 sm:mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">Mes alertes</h1>
            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300">Centralisez vos notifications et suivez les seuils sensibles.</p>
        </div>
        <a href="{{ path('alerte_new') }}" class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-500 px-3 sm:px-4 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span class="hidden sm:inline">Créer une alerte</span>
            <span class="sm:hidden">Créer</span>
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-500/20 dark:bg-emerald-500/10 dark:text-emerald-300">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-300">
            {{ message }}
        </div>
    {% endfor %}

    {% if alertes|length > 0 %}
        <div class="grid grid-cols-1 gap-4 sm:gap-4 lg:grid-cols-2">
            {% for alerte in alertes %}
                <article class="rounded-xl border bg-white p-4 sm:p-5 shadow-sm transition hover:shadow dark:bg-gray-900 {{ alerte.lu ? 'border-gray-200 dark:border-gray-800' : 'border-amber-300 dark:border-amber-500/40' }}">
                    <div class="mb-3 flex items-start justify-between gap-3">
                        <h2 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-gray-100 flex-1 min-w-0 break-words">{{ alerte.titre }}</h2>
                        <span class="inline-flex items-center rounded-full px-2 sm:px-2.5 py-1 text-xs font-medium shrink-0 {{ alerte.lu ? 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200' : 'bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300' }}">
                            {{ alerte.lu ? 'Lue' : 'Non lue' }}
                        </span>
                    </div>

                    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 mb-2 break-words">{{ alerte.message ?: 'Aucun message détaillé.' }}</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-4 break-words">
                        {{ alerte.logement.nom }}
                        {% if alerte.typeEnergie %}
                            · {{ alerte.typeEnergie.nom }}
                        {% endif %}
                        · {{ alerte.createdAt|date('d/m/Y H:i') }}
                    </p>

                    <div class="flex flex-wrap items-center gap-2">
                        <a href="{{ path('alerte_show', {'id': alerte.id}) }}" class="inline-flex items-center rounded-lg border border-gray-300 px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-gray-700 transition hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800">
                            Voir
                        </a>
                        <a href="{{ path('alerte_edit', {'id': alerte.id}) }}" class="inline-flex items-center rounded-lg border border-emerald-300 px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-emerald-700 transition hover:bg-emerald-50 dark:border-emerald-500/30 dark:text-emerald-300 dark:hover:bg-emerald-500/10">
                            Modifier
                        </a>
                        {{ include('alerte/_toggle_read_form.html.twig', { alerte: alerte }) }}
                        {{ include('alerte/_delete_form.html.twig', { alerte: alerte }) }}
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="rounded-xl border border-dashed border-gray-300 bg-white px-4 sm:px-6 py-8 sm:py-12 text-center dark:border-gray-700 dark:bg-gray-900">
            <h2 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">Aucune alerte pour le moment</h2>
            <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 mb-5">Créez votre première alerte pour suivre les situations importantes.</p>
            <a href="{{ path('alerte_new') }}" class="inline-flex items-center gap-2 rounded-lg bg-emerald-500 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-600">
                Créer ma première alerte
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
