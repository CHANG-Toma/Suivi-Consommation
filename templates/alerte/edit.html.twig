{% extends 'base.html.twig' %}

{% block title %}Modifier une alerte - EcoTrack{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-4 py-4 sm:py-6 sm:px-0">
    <div class="mb-4 sm:mb-6">
        <a href="{{ path('alerte_show', {'id': alerte.id}) }}" class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-emerald-600 transition hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            <span class="hidden sm:inline">Retour au détail de l'alerte</span>
            <span class="sm:hidden">Retour</span>
        </a>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-4 sm:p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900 lg:p-8">
        <div class="mb-4 sm:mb-6">
            <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100">Modifier l'alerte</h1>
            <p class="mt-2 text-xs sm:text-sm text-gray-600 dark:text-gray-300">Mettez à jour les informations et l'état de lecture.</p>
        </div>

        {{ include('alerte/_form.html.twig', { form: form, button_label: 'Enregistrer les modifications' }) }}
    </div>
</div>
{% endblock %}
