<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EcoTrack - Suivi de relevés énergétiques{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    <style>
        .app-card {
            transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
        }

        .app-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(2, 8, 23, 0.08);
        }

        [data-app-reveal] {
            opacity: 0;
            transform: translateY(16px);
            transition: opacity 420ms ease, transform 420ms ease;
            will-change: opacity, transform;
        }

        [data-app-reveal].is-visible {
            opacity: 1;
            transform: translateY(0);
        }

        @media (prefers-reduced-motion: reduce) {
            .app-card,
            [data-app-reveal] {
                transition: none !important;
                transform: none !important;
                opacity: 1 !important;
            }
        }

        .safe-area-pb {
            padding-bottom: env(safe-area-inset-bottom, 0);
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-gray-50 dark:bg-gray-900 min-h-screen text-gray-900 dark:text-gray-100 transition-colors">
    {% if app.user %}
        <div class="flex h-screen overflow-hidden">
            {# Sidebar — visible uniquement sur desktop (lg+) #}
            <aside id="app-sidebar" class="hidden lg:flex h-screen w-72 shrink-0 flex-col overflow-hidden bg-white dark:bg-gray-950 border-r border-gray-200 dark:border-gray-800 shadow-sm">
                {# Logo #}
                <div class="p-4 sm:p-5 border-b border-gray-100 dark:border-gray-800 flex items-center justify-between gap-3">
                    <a id="app-brand" href="{{ path('dashboard') }}" class="flex items-center gap-2.5 group min-w-0">
                        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500 text-white text-lg font-bold shadow-sm group-hover:bg-emerald-600 transition-colors">E</span>
                        <span data-sidebar-text class="text-xl font-bold text-gray-800 dark:text-gray-100 group-hover:text-emerald-600 transition-colors truncate">EcoTrack</span>
                    </a>
                    <button
                        id="sidebar-toggle"
                        type="button"
                        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
                        aria-controls="app-sidebar"
                        aria-expanded="true"
                        aria-label="Fermer le menu"
                        title="Fermer le menu"
                    >
                        <svg id="icon-menu" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                        <svg id="icon-close" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6l-12 12"/>
                        </svg>
                    </button>
                </div>
                {# Navigation #}
                <nav class="flex-1 py-5 px-3">
                    <p data-sidebar-text class="px-3 mb-3 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Navigation</p>
                    <ul class="space-y-0.5">
                        <li>
                            <a data-sidebar-item href="{{ path('dashboard') }}" class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium whitespace-nowrap transition-colors duration-150 {{ app.request.attributes.get('_route') == 'dashboard' ? 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 ring-1 ring-emerald-100 dark:ring-emerald-500/20' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white' }}">
                                <svg class="h-5 w-5 shrink-0 {{ app.request.attributes.get('_route') == 'dashboard' ? 'text-emerald-500' : 'text-gray-400' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                                </svg>
                                <span data-sidebar-text>Tableau de bord</span>
                            </a>
                        </li>
                        <li>
                            {% set isLogementRoute = app.request.attributes.get('_route') starts with 'logement_' %}
                            <a data-sidebar-item href="{{ path('logement_index') }}" class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium whitespace-nowrap transition-colors duration-150 {{ isLogementRoute ? 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 ring-1 ring-emerald-100 dark:ring-emerald-500/20' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white' }}">
                                <svg class="h-5 w-5 shrink-0 {{ isLogementRoute ? 'text-emerald-500' : 'text-gray-400' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10l9-7 9 7v10a2 2 0 01-2 2h-4a2 2 0 01-2-2V14H9v6a2 2 0 01-2 2H3z"/>
                                </svg>
                                <span data-sidebar-text>Mes logements</span>
                            </a>
                        </li>
                        <li>
                            {% set isConsommationRoute = app.request.attributes.get('_route') starts with 'consommation_' %}
                            <a data-sidebar-item href="{{ path('consommation_index') }}" class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium whitespace-nowrap transition-colors duration-150 {{ isConsommationRoute ? 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 ring-1 ring-emerald-100 dark:ring-emerald-500/20' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white' }}">
                                <svg class="h-5 w-5 shrink-0 {{ isConsommationRoute ? 'text-emerald-500' : 'text-gray-400' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6m4 6V7m4 10v-3M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                                </svg>
                                <span data-sidebar-text>Relevés</span>
                            </a>
                        </li>
                        <li>
                            {% set isAlerteRoute = app.request.attributes.get('_route') starts with 'alerte_' %}
                            <a data-sidebar-item href="{{ path('alerte_index') }}" class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium whitespace-nowrap transition-colors duration-150 {{ isAlerteRoute ? 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 ring-1 ring-emerald-100 dark:ring-emerald-500/20' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white' }}">
                                <svg class="h-5 w-5 shrink-0 {{ isAlerteRoute ? 'text-emerald-500' : 'text-gray-400' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.17V11a6 6 0 10-12 0v3.17c0 .53-.21 1.04-.59 1.43L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                                </svg>
                                <span data-sidebar-text>Alertes</span>
                            </a>
                        </li>
                    </ul>
                </nav>
                {# Actions #}
                <div class="p-3 border-t border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-900">
                    <button id="theme-toggle" type="button" data-sidebar-item class="group w-full flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white transition-colors duration-150">
                        <svg id="icon-theme-moon" class="h-5 w-5 shrink-0 text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-200 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3c-.4 1.1-.62 2.28-.62 3.5a9 9 0 0010.41 8.29z"/>
                        </svg>
                        <svg id="icon-theme-sun" class="hidden h-5 w-5 shrink-0 text-amber-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36 6.36l-1.41-1.41M7.05 7.05L5.64 5.64m12.72 0l-1.41 1.41M7.05 16.95l-1.41 1.41M12 8a4 4 0 100 8 4 4 0 000-8z"/>
                        </svg>
                        <span id="theme-toggle-text" data-sidebar-text>Mode sombre</span>
                    </button>
                    <a data-sidebar-item href="{{ path('logout') }}" class="group mt-1 flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-red-500/10 hover:text-red-600 dark:hover:text-red-300 transition-colors duration-150">
                        <svg class="h-5 w-5 shrink-0 text-gray-400 group-hover:text-red-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                        </svg>
                        <span data-sidebar-text>Déconnexion</span>
                    </a>
                </div>
            </aside>
            {# Contenu principal — padding bas pour la barre de navigation mobile #}
            <main class="flex-1 overflow-y-auto pb-20 lg:pb-0">
    {% else %}
        {% set isPublicHome = app.request.attributes.get('_route') == 'home' %}
        <main class="{{ isPublicHome ? 'min-h-screen' : 'min-h-screen flex items-center justify-center' }}">
    {% endif %}
                {% if app.user %}
                    <header class="sticky top-0 z-30 border-b border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-950/90 backdrop-blur px-4 sm:px-6 lg:px-8 py-3">
                        <div class="flex items-center justify-between">
                            <a href="{{ path('dashboard') }}" class="flex items-center gap-2 lg:hidden">
                                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500 text-white text-lg font-bold shadow-sm">E</span>
                                <span class="text-lg font-bold text-gray-800 dark:text-gray-100">EcoTrack</span>
                            </a>
                            <div class="hidden lg:block lg:flex-1"></div>
                            <a href="{{ path('profile_index') }}" class="ml-auto inline-flex items-center gap-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A9 9 0 1118.88 17.8M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                <span class="hidden sm:inline">Mon Profile</span>
                            </a>
                        </div>
                    </header>
                    <div class="py-4 sm:py-6 px-4 sm:px-6 lg:px-8">
                {% endif %}
                {% block body %}{% endblock %}
                {% if app.user %}
                    </div>
                {% endif %}
            </main>
    {% if app.user %}
        </div>
        
        {# Barre de navigation fixe en bas — mobile uniquement #}
        <nav class="fixed bottom-0 left-0 right-0 z-50 flex lg:hidden items-center justify-around border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 shadow-lg safe-area-pb" aria-label="Navigation principale">
            {% set _route = app.request.attributes.get('_route') %}
            <a href="{{ path('dashboard') }}" class="flex flex-1 flex-col items-center gap-1 py-2.5 px-2 text-center transition-colors {{ _route == 'dashboard' ? 'text-emerald-600 dark:text-emerald-400' : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100' }}">
                <svg class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                </svg>
                <span class="text-[10px] font-medium">Tableau de bord</span>
            </a>
            <a href="{{ path('logement_index') }}" class="flex flex-1 flex-col items-center gap-1 py-2.5 px-2 text-center transition-colors {{ _route starts with 'logement_' ? 'text-emerald-600 dark:text-emerald-400' : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100' }}">
                <svg class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10l9-7 9 7v10a2 2 0 01-2 2h-4a2 2 0 01-2-2V14H9v6a2 2 0 01-2 2H3z"/>
                </svg>
                <span class="text-[10px] font-medium">Logements</span>
            </a>
            <a href="{{ path('consommation_index') }}" class="flex flex-1 flex-col items-center gap-1 py-2.5 px-2 text-center transition-colors {{ _route starts with 'consommation_' ? 'text-emerald-600 dark:text-emerald-400' : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100' }}">
                <svg class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6m4 6V7m4 10v-3M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
                <span class="text-[10px] font-medium">Relevés</span>
            </a>
            <a href="{{ path('alerte_index') }}" class="flex flex-1 flex-col items-center gap-1 py-2.5 px-2 text-center transition-colors {{ _route starts with 'alerte_' ? 'text-emerald-600 dark:text-emerald-400' : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100' }}">
                <svg class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.17V11a6 6 0 10-12 0v3.17c0 .53-.21 1.04-.59 1.43L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                </svg>
                <span class="text-[10px] font-medium">Alertes</span>
            </a>
        </nav>
    {% endif %}

    {% if app.user %}
        {% set warningPopups = app.flashes('warning_popup') %}
        {% if warningPopups|length > 0 %}
            <div id="warning-popup-overlay" class="fixed inset-0 z-40 bg-gray-900/50 backdrop-blur-sm"></div>
            <div id="warning-popup-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4">
                <div class="w-full max-w-xl rounded-xl border border-amber-200 bg-white shadow-xl dark:border-amber-500/30 dark:bg-gray-900">
                    <div class="border-b border-amber-200 bg-amber-50 px-5 py-4 dark:border-amber-500/30 dark:bg-amber-500/10">
                        <h3 class="text-lg font-semibold text-amber-800 dark:text-amber-300">Seuil d'alerte atteint</h3>
                    </div>
                    <div class="px-5 py-4">
                        <ul class="space-y-2">
                            {% for popupMessage in warningPopups %}
                                <li class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200">
                                    {{ popupMessage }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                    <div class="flex justify-end gap-2 border-t border-gray-200 px-5 py-3 dark:border-gray-800">
                        <button
                            id="warning-popup-close"
                            type="button"
                            class="inline-flex items-center rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-600"
                        >
                            Compris
                        </button>
                    </div>
                </div>
            </div>
        {% endif %}

        <script>
            (function () {
                const sidebar = document.getElementById('app-sidebar');
                const toggle = document.getElementById('sidebar-toggle');
                const menuIcon = document.getElementById('icon-menu');
                const closeIcon = document.getElementById('icon-close');
                const themeToggle = document.getElementById('theme-toggle');
                const themeText = document.getElementById('theme-toggle-text');
                const themeMoonIcon = document.getElementById('icon-theme-moon');
                const themeSunIcon = document.getElementById('icon-theme-sun');
                const brand = document.getElementById('app-brand');
                const textNodes = document.querySelectorAll('[data-sidebar-text]');
                const itemNodes = document.querySelectorAll('[data-sidebar-item]');
                const storageKey = 'ecotrack.sidebar.collapsed';
                const themeStorageKey = 'ecotrack.theme.dark';
                const root = document.documentElement;

                const setCollapsed = (collapsed) => {
                    if (!sidebar) return;
                    sidebar.classList.toggle('w-72', !collapsed);
                    sidebar.classList.toggle('w-20', collapsed);
                    sidebar.classList.toggle('border-r', !collapsed);
                    if (toggle) {
                        toggle.setAttribute('aria-expanded', String(!collapsed));
                        toggle.setAttribute('aria-label', collapsed ? 'Ouvrir le menu' : 'Fermer le menu');
                        toggle.setAttribute('title', collapsed ? 'Ouvrir le menu' : 'Fermer le menu');
                    }
                    if (menuIcon) menuIcon.classList.toggle('hidden', !collapsed);
                    if (closeIcon) closeIcon.classList.toggle('hidden', collapsed);
                    textNodes.forEach((node) => node.classList.toggle('hidden', collapsed));
                    itemNodes.forEach((node) => node.classList.toggle('justify-center', collapsed));
                    if (brand) brand.classList.toggle('justify-center', collapsed);
                };

                const setDarkTheme = (isDark) => {
                    root.classList.toggle('dark', isDark);
                    if (themeText) themeText.textContent = isDark ? 'Mode clair' : 'Mode sombre';
                    if (themeMoonIcon) themeMoonIcon.classList.toggle('hidden', isDark);
                    if (themeSunIcon) themeSunIcon.classList.toggle('hidden', !isDark);
                };

                const initialCollapsed = localStorage.getItem(storageKey) === 'true';
                setCollapsed(initialCollapsed);

                const savedTheme = localStorage.getItem(themeStorageKey);
                const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                setDarkTheme(savedTheme ? savedTheme === 'true' : prefersDark);

                if (toggle) {
                    toggle.addEventListener('click', () => {
                        const collapsed = sidebar && sidebar.classList.contains('w-20');
                        setCollapsed(!collapsed);
                        localStorage.setItem(storageKey, String(!collapsed));
                    });
                }

                if (themeToggle) {
                    themeToggle.addEventListener('click', () => {
                        const isDark = root.classList.contains('dark');
                        const next = !isDark;
                        setDarkTheme(next);
                        localStorage.setItem(themeStorageKey, String(next));
                    });
                }

                const popupOverlay = document.getElementById('warning-popup-overlay');
                const popupModal = document.getElementById('warning-popup-modal');
                const popupClose = document.getElementById('warning-popup-close');
                const closePopup = () => {
                    if (popupOverlay) popupOverlay.remove();
                    if (popupModal) popupModal.remove();
                };
                if (popupClose) {
                    popupClose.addEventListener('click', closePopup);
                }
                if (popupOverlay) {
                    popupOverlay.addEventListener('click', closePopup);
                }

                const revealNodes = document.querySelectorAll('[data-app-reveal]');
                if (revealNodes.length > 0 && 'IntersectionObserver' in window) {
                    const revealObserver = new IntersectionObserver((entries, obs) => {
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;
                            entry.target.classList.add('is-visible');
                            obs.unobserve(entry.target);
                        });
                    }, { threshold: 0.12 });

                    revealNodes.forEach((node, index) => {
                        node.style.transitionDelay = `${Math.min(index * 25, 220)}ms`;
                        revealObserver.observe(node);
                    });
                } else {
                    revealNodes.forEach((node) => node.classList.add('is-visible'));
                }
            })();
        </script>
    {% endif %}
    {% block javascripts %}{% endblock %}
</body>
</html>
