{
    "require": {
        "php": ">=8.2.0",
        "symfony/webapp-pack": "^1.4",
        "symfony/runtime": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/dotenv": "^7.4"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "DoctrineMigrations\\": "migrations/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.12"
        },
        "platform-check": false
    }
}
